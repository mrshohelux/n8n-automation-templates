{
  "name": "API Call With Exponential Backoff + Dead Letter",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "process-order",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Webhook: Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 320],
      "webhookId": "PLACEHOLDER_WEBHOOK_ID"
    },
    {
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            { "name": "attempt", "stringValue": "={{ 0 }}" }
          ]
        }
      },
      "id": "set-attempt",
      "name": "Set: attempt = 0",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 320]
    },
    {
      "parameters": {
        "content": "## The problem this solves\nA raw HTTP Request node treats a 429 (rate limit) or a transient 500 the same as a permanent failure — it just stops. Real third-party APIs (payment processors, CRMs, email providers) throw these constantly under normal load. This graph retries intelligently instead of breaking the whole automation.",
        "height": 200,
        "width": 280
      },
      "id": "sticky-1",
      "name": "Note: Problem",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [200, 80]
    },
    {
      "parameters": {
        "url": "={{ $json.target_endpoint }}",
        "method": "POST",
        "options": {
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "http-call",
      "name": "HTTP: Call Third-Party API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 320]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 299,
              "operator": { "type": "number", "operation": "lte" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-success",
      "name": "IF: Response OK (2xx)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [940, 320]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $('Set: attempt = 0').item.json.attempt }}",
              "rightValue": 5,
              "operator": { "type": "number", "operation": "lt" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-retries-left",
      "name": "IF: Retries Remaining (<5)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1180, 460]
    },
    {
      "parameters": {
        "amount": "={{ Math.pow(2, $('Set: attempt = 0').item.json.attempt) }}",
        "unit": "seconds"
      },
      "id": "wait-backoff",
      "name": "Wait: Exponential Backoff (2^n sec)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1420, 460]
    },
    {
      "parameters": {
        "content": "## Backoff math\nattempt 0 → wait 1s, attempt 1 → 2s, attempt 2 → 4s, attempt 3 → 8s, attempt 4 → 16s. Caps out at 5 attempts (~31s total) before giving up and routing to the dead-letter log — bounded, so a persistently-down API can't stall the queue forever.",
        "height": 180,
        "width": 260
      },
      "id": "sticky-2",
      "name": "Note: Backoff math",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1400, 260]
    },
    {
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            { "name": "attempt", "stringValue": "={{ $('Set: attempt = 0').item.json.attempt + 1 }}" }
          ]
        }
      },
      "id": "set-increment",
      "name": "Set: attempt += 1",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1660, 460]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "mode": "id", "value": "PLACEHOLDER_SHEET_ID" },
        "sheetName": { "mode": "name", "value": "Dead Letter Queue" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "endpoint": "={{ $json.target_endpoint }}",
            "last_status_code": "={{ $json.statusCode }}",
            "attempts_made": "={{ $('Set: attempt = 0').item.json.attempt }}",
            "failed_at": "={{ $now.toISO() }}"
          }
        }
      },
      "id": "sheets-deadletter",
      "name": "Log: Dead Letter (manual review)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1180, 620],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "PLACEHOLDER_CRED_ID", "name": "PLACEHOLDER Google Sheets account" }
      }
    }
  ],
  "connections": {
    "Webhook: Trigger": {
      "main": [[{ "node": "Set: attempt = 0", "type": "main", "index": 0 }]]
    },
    "Set: attempt = 0": {
      "main": [[{ "node": "HTTP: Call Third-Party API", "type": "main", "index": 0 }]]
    },
    "HTTP: Call Third-Party API": {
      "main": [[{ "node": "IF: Response OK (2xx)", "type": "main", "index": 0 }]]
    },
    "IF: Response OK (2xx)": {
      "main": [
        [],
        [{ "node": "IF: Retries Remaining (<5)", "type": "main", "index": 0 }]
      ]
    },
    "IF: Retries Remaining (<5)": {
      "main": [
        [{ "node": "Wait: Exponential Backoff (2^n sec)", "type": "main", "index": 0 }],
        [{ "node": "Log: Dead Letter (manual review)", "type": "main", "index": 0 }]
      ]
    },
    "Wait: Exponential Backoff (2^n sec)": {
      "main": [[{ "node": "Set: attempt += 1", "type": "main", "index": 0 }]]
    },
    "Set: attempt += 1": {
      "main": [[{ "node": "HTTP: Call Third-Party API", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
